#%Module
# This is a template file
# TODO: Copy it into a directory on your MODULEPATH as "cspa" and set the two paths below:
set root   /path/to/cryoem_tools # installation path
set python /path/to/envs/cspa/bin/python # cspa python installation path

module-whatis "Cryo-EM SPA Toolkit"

# set environment variables and path
setenv CSPA_ROOT   $root
setenv CSPA_PYTHON $python
prepend-path PATH $root/bin # expose wrappers and utilities

# enable tab completion
if {[module-info shell] eq "bash"} {
    if {[module-info mode load]} {
        puts stdout "source $root/modulefiles/cspa-completion.bash;"
    } elseif {[module-info mode remove]} {
        # cleanup when unloading
        puts stdout "complete -r cspa 2>/dev/null; unset -f _cspa;"
    }
}
